# Exercise rejected CLI input with bounded subprocess lifetimes and fresh outputs.
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(base "${BINARY}/cli-rejection-${suffix}")
foreach(case negative partial overflow seed_overflow bench_count resume_export)
 set(out "${base}/${case}")
 if(case STREQUAL resume_export)
  execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/duel.json" --commands "${FIXTURES}/orders-attack.json" --ticks 1 --out "${base}/save" RESULT_VARIABLE saved TIMEOUT 5 OUTPUT_QUIET ERROR_QUIET)
  if(NOT saved STREQUAL "0")
   message(FATAL_ERROR "cannot create CLI test save: ${saved}")
  endif()
  set(args run --resume "${base}/save/snapshot.json" --replay-out "${base}/unsupported-replay.json" --ticks 1 --out "${out}")
 elseif(case STREQUAL bench_count)
  set(args bench --units 4294967297 --ticks 1 --out "${out}")
 else()
  if(case STREQUAL negative)
   set(value -1)
  elseif(case STREQUAL partial)
   set(value 10junk)
  else()
   set(value 18446744073709551616)
  endif()
  if(case STREQUAL seed_overflow)
   set(args run --scenario "${FIXTURES}/duel.json" --seed "${value}" --ticks 1 --out "${out}")
  else()
   set(args run --scenario "${FIXTURES}/duel.json" --ticks "${value}" --out "${out}")
  endif()
 endif()
 execute_process(COMMAND "${CLI}" ${args} RESULT_VARIABLE result TIMEOUT 1 OUTPUT_QUIET ERROR_QUIET)
 if(NOT result STREQUAL "2")
  message(SEND_ERROR "${case}: expected exit2; got ${result}")
 endif()
 if(EXISTS "${out}" OR (case STREQUAL resume_export AND EXISTS "${base}/unsupported-replay.json"))
  message(SEND_ERROR "${case}: rejected input created output")
 endif()
endforeach()
# A benchmark override must reach the actual simulation, not only CLI parsing.
set(cohort_out "${base}/cohort-one")
execute_process(COMMAND "${CLI}" bench --units 200 --modes volley --ticks 4 --warmup 0 --ranged-cohorts 1 --repetitions 1 --out "${cohort_out}" RESULT_VARIABLE result TIMEOUT 5 OUTPUT_QUIET ERROR_QUIET)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "cohort override benchmark failed: ${result}")
endif()
file(READ "${cohort_out}/summary.jsonl" summary)
string(JSON actual_cohorts GET "${summary}" ranged_cohorts)
if(NOT actual_cohorts EQUAL 1)
 message(FATAL_ERROR "CLI ignored --ranged-cohorts1: actual=${actual_cohorts}")
endif()
