# Exercise rejected CLI input with bounded subprocess lifetimes and fresh outputs.
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(base "${BINARY}/cli-rejection-${suffix}")
foreach(case negative partial overflow seed_overflow bench_count resume_export)
 set(out "${base}/${case}")
 if(case STREQUAL resume_export)
  execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/duel.json" --commands "${FIXTURES}/orders-attack.json" --ticks 1 --out "${base}/save" RESULT_VARIABLE saved TIMEOUT 5 OUTPUT_QUIET ERROR_QUIET)
  if(NOT saved STREQUAL "0")
   message(FATAL_ERROR "cannot create CLI test save: ${saved}")
  endif()
  set(args run --resume "${base}/save/snapshot.json" --replay-out "${base}/unsupported-replay.json" --ticks 1 --out "${out}")
 elseif(case STREQUAL bench_count)
  set(args bench --units 4294967297 --ticks 1 --out "${out}")
 else()
  if(case STREQUAL negative)
   set(value -1)
  elseif(case STREQUAL partial)
   set(value 10junk)
  else()
   set(value 18446744073709551616)
  endif()
  if(case STREQUAL seed_overflow)
   set(args run --scenario "${FIXTURES}/duel.json" --seed "${value}" --ticks 1 --out "${out}")
  else()
   set(args run --scenario "${FIXTURES}/duel.json" --ticks "${value}" --out "${out}")
  endif()
 endif()
 execute_process(COMMAND "${CLI}" ${args} RESULT_VARIABLE result TIMEOUT 1 OUTPUT_QUIET ERROR_QUIET)
 if(NOT result STREQUAL "2")
  message(SEND_ERROR "${case}: expected exit2; got ${result}")
 endif()
 if(EXISTS "${out}" OR (case STREQUAL resume_export AND EXISTS "${base}/unsupported-replay.json"))
  message(SEND_ERROR "${case}: rejected input created output")
 endif()
endforeach()

# A command task supplied through the ordinary command file is accepted by the army brain.
set(command_file "${base}/army-task.json")
file(WRITE "${command_file}" "[{\"tick\":0,\"sequence\":1,\"command\":{\"kind\":7,\"command_task\":{\"recipient\":1,\"action\":2,\"intent\":{\"target_regiment\":2,\"objective_position\":{\"x\":10,\"y\":0,\"z\":0}}}}}]")
file(WRITE "${base}/no-task.json" "[]")
execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/command-battle.json" --commands "${command_file}" --ticks 1 --snapshot-out "${base}/command-snapshot.json" --replay-out "${base}/command-run/replay.json" --out "${base}/command-run" RESULT_VARIABLE command_result TIMEOUT 10 OUTPUT_VARIABLE command_output ERROR_VARIABLE command_error)
if(NOT command_result STREQUAL "0")
 message(FATAL_ERROR "CLI rejected IssueCommandTask: ${command_result} ${command_error}")
endif()
execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/command-battle.json" --commands "${base}/no-task.json" --ticks 1 --out "${base}/no-task-run" RESULT_VARIABLE no_task_result TIMEOUT 10 OUTPUT_VARIABLE no_task_output ERROR_QUIET)
if(NOT no_task_result STREQUAL "0")
 message(FATAL_ERROR "CLI failed command hierarchy baseline: ${no_task_result}")
endif()
string(REGEX MATCH "hash=([0-9]+)" _ "${command_output}")
set(command_hash "${CMAKE_MATCH_1}")
string(REGEX MATCH "hash=([0-9]+)" _ "${no_task_output}")
set(no_task_hash "${CMAKE_MATCH_1}")
if(command_hash STREQUAL "" OR no_task_hash STREQUAL "" OR command_hash STREQUAL no_task_hash)
 message(FATAL_ERROR "IssueCommandTask did not produce a distinct persisted army plan: ${command_output} / ${no_task_output}")
endif()
file(READ "${base}/command-snapshot.json" command_snapshot)
string(JSON snapshot_schema GET "${command_snapshot}" schema_version)
string(JSON root_task_count LENGTH "${command_snapshot}" state command_state nodes 0 orders)
if(NOT snapshot_schema EQUAL 3 OR root_task_count LESS 1)
 message(FATAL_ERROR "command snapshot did not persist the army order (schema=${snapshot_schema}, tasks=${root_task_count})")
endif()
execute_process(COMMAND "${CLI}" run --resume "${base}/command-snapshot.json" --ticks 30 --out "${base}/resumed" RESULT_VARIABLE resume_result TIMEOUT 10 OUTPUT_VARIABLE resume_output ERROR_VARIABLE resume_error)
execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/command-battle.json" --commands "${command_file}" --ticks 31 --out "${base}/continuous" RESULT_VARIABLE continuous_result TIMEOUT 10 OUTPUT_VARIABLE continuous_output ERROR_VARIABLE continuous_error)
execute_process(COMMAND "${CLI}" replay --replay "${base}/command-run/replay.json" --ticks 31 --out "${base}/replayed" RESULT_VARIABLE replay_result TIMEOUT 10 OUTPUT_VARIABLE replay_output ERROR_VARIABLE replay_error)
if(NOT resume_result STREQUAL "0" OR NOT continuous_result STREQUAL "0" OR NOT replay_result STREQUAL "0")
 message(FATAL_ERROR "command resume/replay failed: resume=${resume_error}, run=${continuous_error}, replay=${replay_error}")
endif()
string(REGEX MATCH "hash=([0-9]+)" _ "${resume_output}")
set(resume_hash "${CMAKE_MATCH_1}")
string(REGEX MATCH "hash=([0-9]+)" _ "${continuous_output}")
set(continuous_hash "${CMAKE_MATCH_1}")
string(REGEX MATCH "hash=([0-9]+)" _ "${replay_output}")
set(replay_hash "${CMAKE_MATCH_1}")
if(resume_hash STREQUAL "" OR NOT resume_hash STREQUAL continuous_hash OR NOT resume_hash STREQUAL replay_hash)
 message(FATAL_ERROR "command run/resume/replay hashes differ: ${resume_hash} / ${continuous_hash} / ${replay_hash}")
endif()

# Task command fields must remain integers at the CLI boundary.
file(WRITE "${base}/fractional-task.json" "[{\"tick\":0.5,\"sequence\":1,\"command\":{\"kind\":7,\"command_task\":{\"recipient\":1,\"action\":2}}}]")
execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/command-battle.json" --commands "${base}/fractional-task.json" --ticks 1 --out "${base}/fractional-task-output" RESULT_VARIABLE fractional_result TIMEOUT 10 OUTPUT_QUIET ERROR_QUIET)
if(NOT fractional_result STREQUAL "2" OR EXISTS "${base}/fractional-task-output")
 message(SEND_ERROR "CLI accepted a fractional command tick or created output: ${fractional_result}")
endif()
# A benchmark override must reach the actual simulation, not only CLI parsing.
set(cohort_out "${base}/cohort-one")
execute_process(COMMAND "${CLI}" bench --units 200 --modes volley --ticks 4 --warmup 0 --ranged-cohorts 1 --repetitions 1 --out "${cohort_out}" RESULT_VARIABLE result TIMEOUT 5 OUTPUT_QUIET ERROR_QUIET)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "cohort override benchmark failed: ${result}")
endif()
file(READ "${cohort_out}/summary.jsonl" summary)
string(JSON actual_cohorts GET "${summary}" ranged_cohorts)
if(NOT actual_cohorts EQUAL 1)
 message(FATAL_ERROR "CLI ignored --ranged-cohorts1: actual=${actual_cohorts}")
endif()
# Replay records must not silently default a persisted rule or input kind.
file(WRITE "${base}/control-commands.json" "[{\"tick\":0,\"sequence\":1,\"command\":{\"kind\":2,\"unit\":1}}]")
execute_process(COMMAND "${CLI}" run --scenario "${FIXTURES}/duel.json" --commands "${base}/control-commands.json" --ticks 1 --replay-out "${base}/complete-replay.json" --out "${base}/replay-source" RESULT_VARIABLE result TIMEOUT 5 OUTPUT_QUIET ERROR_QUIET)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "cannot create replay test record: ${result}")
endif()
file(READ "${base}/complete-replay.json" replay)
foreach(field cohort command_kind)
 if(field STREQUAL cohort)
  string(JSON damaged REMOVE "${replay}" scenario rules ranged_cohorts)
 else()
  string(JSON damaged REMOVE "${replay}" commands 0 command kind)
 endif()
 file(WRITE "${base}/missing-${field}.json" "${damaged}")
 execute_process(COMMAND "${CLI}" replay --replay "${base}/missing-${field}.json" --ticks 0 --out "${base}/accepted-${field}" RESULT_VARIABLE result TIMEOUT 5 OUTPUT_QUIET ERROR_QUIET)
 if(NOT result STREQUAL "2")
  message(SEND_ERROR "replay with missing ${field} accepted: ${result}")
 endif()
 if(EXISTS "${base}/accepted-${field}")
  message(SEND_ERROR "rejected replay created output: ${field}")
 endif()
endforeach()
