cmake_minimum_required(VERSION 3.25)

function(run_round mode output workers)
    execute_process(COMMAND "${TRAINING}" "${mode}" "${output}" 1 "${workers}" ${ARGN}
                    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 90)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode} failed (${result})\n${log}${error}")
    endif()
endfunction()

run_round(collect-historical-v4 "${OUT}/serial" 1)
run_round(collect-historical-v4 "${OUT}/parallel" 4)
file(SHA256 "${OUT}/serial/rollouts.csv" serial)
file(SHA256 "${OUT}/parallel/rollouts.csv" parallel)
if(NOT serial STREQUAL parallel)
    message(FATAL_ERROR "Parallel branch collection changed the recorded outcomes.")
endif()
file(STRINGS "${OUT}/parallel/rollouts.csv" development REGEX "^(train|validation),")
if(NOT development MATCHES "(^|;)train," OR NOT development MATCHES "(^|;)validation,")
    message(FATAL_ERROR "The fourth round needs both development splits.")
endif()

string(REPEAT " 0" 841 weights)
file(WRITE "${OUT}/zero.txt" "BATTLE_GROUP_MLP 3 33 24 0.0${weights}\n")
run_round(evaluate-historical-v4 "${OUT}/holdout" 4 "${OUT}/zero.txt")
file(STRINGS "${OUT}/holdout/evaluation.csv" evaluation REGEX "^holdout,")
list(LENGTH evaluation count)
if(NOT count EQUAL 12)
    message(FATAL_ERROR "Four withheld maps must each have three policies on the same start.")
endif()
set(maps)
foreach(row IN LISTS evaluation)
    string(REPLACE "," ";" columns "${row}")
    list(GET columns 1 name)
    if(development MATCHES "(^|;)(train|validation),${name},")
        message(FATAL_ERROR "Holdout map ${name} appeared in the development rows.")
    endif()
    list(APPEND maps "${name}")
endforeach()
list(REMOVE_DUPLICATES maps)
list(LENGTH maps count)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "Expected four entire withheld maps.")
endif()
foreach(map IN LISTS maps)
    if(NOT evaluation MATCHES "holdout,${map},([0-9]+),fsm,")
        message(FATAL_ERROR "Missing FSM baseline for ${map}.")
    endif()
    set(seed "${CMAKE_MATCH_1}")
    if(NOT evaluation MATCHES "holdout,${map},${seed},held,[0-9]+,([0-9]+),")
        message(FATAL_ERROR "Missing rule baseline hash for ${map}.")
    endif()
    set(hash "${CMAKE_MATCH_1}")
    if(NOT evaluation MATCHES "holdout,${map},${seed},trained,[0-9]+,${hash},")
        message(FATAL_ERROR "A zero policy changed the held baseline state on ${map}.")
    endif()
endforeach()
