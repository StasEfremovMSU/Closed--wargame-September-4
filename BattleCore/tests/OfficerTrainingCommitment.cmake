cmake_minimum_required(VERSION 3.25)

function(run_training mode out workers)
    execute_process(COMMAND "${TRAINING}" "${mode}" "${out}" 1 "${workers}" ${ARGN}
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${mode} failed (${status})\n${output}${error}")
    endif()
endfunction()

run_training(collect-historical-v3 "${OUT}/single" 1)
run_training(collect-historical-v3 "${OUT}/parallel" 4)
file(SHA256 "${OUT}/single/rollouts.csv" single)
file(SHA256 "${OUT}/parallel/rollouts.csv" parallel)
if(NOT single STREQUAL parallel)
    message(FATAL_ERROR "V3 collection differs between one and four workers.")
endif()
file(STRINGS "${OUT}/single/rollouts.csv" rows)
list(POP_FRONT rows header)
if(NOT header MATCHES "available_count,behavior,.*choose_keep,order_pending,order_executing,order_age,order_progress,utility,"
   OR NOT rows MATCHES "(^|;)train,[^,]+,[0-9]+,[^;]*,keep,"
   OR NOT rows MATCHES "(^|;)validation,ancient_"
   OR NOT rows MATCHES "(^|;)validation,napoleonic_")
    message(FATAL_ERROR "V3 collection omitted Keep, commitment features or validation coverage.")
endif()

string(REPEAT " 0" 841 v3_weights)
file(WRITE "${OUT}/v3-zero.txt" "BATTLE_GROUP_MLP 3 33 24 0.0${v3_weights}\n")
run_training(collect-historical-v3 "${OUT}/model-visits" 4 "${OUT}/v3-zero.txt")
file(STRINGS "${OUT}/model-visits/rollouts.csv" visits)
list(POP_FRONT visits header)
foreach(visit IN LISTS visits)
    if(NOT visit MATCHES "^train,[^,]+,[0-9]+,[^;]*,trained,")
        message(FATAL_ERROR "Follow-up collection must use trained-policy visits on training worlds.")
    endif()
endforeach()
if(NOT visits)
    message(FATAL_ERROR "Follow-up collection did not capture trained-policy visits.")
endif()
run_training(validate-historical-v3 "${OUT}/validation" 4 "${OUT}/v3-zero.txt")
file(STRINGS "${OUT}/validation/evaluation.csv" outcomes)
list(POP_FRONT outcomes header)
list(LENGTH outcomes count)
if(NOT count EQUAL 12 OR NOT header MATCHES "meaningful_order_changes,early_order_changes")
    message(FATAL_ERROR "V3 validation does not expose four comparable three-policy runs.")
endif()
foreach(policy IN ITEMS fsm held trained)
    set(count 0)
    foreach(row IN LISTS outcomes)
        if(row MATCHES "^validation,[^,]+,[0-9]+,${policy},")
            math(EXPR count "${count} + 1")
        endif()
    endforeach()
    if(NOT count EQUAL 4)
        message(FATAL_ERROR "V3 validation policy ${policy} does not have four starts.")
    endif()
endforeach()
file(STRINGS "${OUT}/validation/evaluation-decisions.csv" decisions)
if(NOT decisions MATCHES "(^|;)validation,[^;]+,held," OR NOT decisions MATCHES "(^|;)validation,[^;]+,trained,")
    message(FATAL_ERROR "V3 validation did not capture held and trained choices.")
endif()

execute_process(COMMAND "${TRAINING}" validate-historical-v3 "${OUT}/invalid" 1 1 "${LEGACY_WEIGHTS}"
                RESULT_VARIABLE rejected ERROR_VARIABLE reason TIMEOUT 10)
if(rejected EQUAL 0 OR NOT reason MATCHES "V3")
    message(FATAL_ERROR "V3 accepted an incompatible model or gave an unclear error.")
endif()
