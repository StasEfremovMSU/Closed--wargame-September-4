cmake_minimum_required(VERSION 3.20)

set(revision "")
# A live order stays committed through delivery and early execution. Sample
# several starts to cover both ford families without counting duplicate orders.
set(seeds 4)
if(NEXT_ROUND)
    set(revision "-v2")
    set(seeds 6)
endif()
execute_process(COMMAND "${TRAINING}" "collect-historical${revision}" "${OUT}" "${seeds}" 2
                RESULT_VARIABLE collected TIMEOUT 90)
if(NOT collected EQUAL 0)
    message(FATAL_ERROR "The historical collector rejected the pilot exercises.")
endif()
file(STRINGS "${OUT}/rollouts.csv" rows)
list(POP_FRONT rows header)
string(REPLACE "," ";" columns "${header}")
list(FIND columns "ranged_pressure" pressure_column)
if(pressure_column LESS 0)
    message(FATAL_ERROR "The rollout data omits the fire-pressure feature.")
endif()
foreach(expected IN ITEMS "train,ancient_ford," "train,napoleonic_ford,"
                          "validation,ancient_" "validation,napoleonic_")
    if(NOT rows MATCHES "(^|;)${expected}")
        message(FATAL_ERROR "Missing historical collection rows for ${expected}")
    endif()
endforeach()
set(musket_pressure FALSE)
foreach(row IN LISTS rows)
    if(row MATCHES "^train,napoleonic_")
        string(REPLACE "," ";" fields "${row}")
        list(GET fields ${pressure_column} pressure)
        if(pressure STREQUAL "1")
            set(musket_pressure TRUE)
            break()
        endif()
    endif()
endforeach()
if(NOT musket_pressure)
    message(FATAL_ERROR "The collector missed all decisions under musket fire.")
endif()
string(REGEX MATCHALL "(train|validation),[^,;]+" sampled "${rows}")
set(training_names "")
set(validation_names "")
foreach(item IN LISTS sampled)
    string(REPLACE "," ";" fields "${item}")
    list(GET fields 0 split)
    list(GET fields 1 family)
    if(split STREQUAL "train")
        list(APPEND training_names "${family}")
    else()
        list(APPEND validation_names "${family}")
    endif()
endforeach()
foreach(family IN LISTS validation_names)
    if(family IN_LIST training_names)
        message(FATAL_ERROR "The validation family ${family} is also used in training.")
    endif()
endforeach()
if(NEXT_ROUND)
    execute_process(COMMAND "${TRAINING}" validate-historical-v2 "${OUT}" "${seeds}" 2 "${WEIGHTS}"
                    RESULT_VARIABLE validated TIMEOUT 90)
    if(NOT validated EQUAL 0)
        message(FATAL_ERROR "The historical evaluator could not replay the validation scenarios.")
    endif()
    file(STRINGS "${OUT}/evaluation.csv" validation_battles)
    foreach(family IN LISTS training_names)
        if(validation_battles MATCHES "(^|;)validation,${family},")
            message(FATAL_ERROR "Validation used the training family ${family}.")
        endif()
    endforeach()
    foreach(family IN LISTS validation_names)
        if(NOT validation_battles MATCHES "(^|;)validation,${family},")
            message(FATAL_ERROR "Missing validation battles for ${family}.")
        endif()
    endforeach()
endif()
execute_process(COMMAND "${TRAINING}" "evaluate-historical${revision}" "${OUT}" 1 2 "${WEIGHTS}"
                RESULT_VARIABLE evaluated TIMEOUT 60)
if(NOT evaluated EQUAL 0)
    message(FATAL_ERROR "The historical evaluator could not replay the holdout.")
endif()
file(STRINGS "${OUT}/evaluation.csv" evaluations)
foreach(expected IN ITEMS "holdout,ancient_" "holdout,napoleonic_")
    if(NOT evaluations MATCHES "(^|;)${expected}")
        message(FATAL_ERROR "Missing historical evaluation rows for ${expected}")
    endif()
endforeach()
foreach(family IN LISTS training_names validation_names)
    if(evaluations MATCHES "(^|;)holdout,${family},")
        message(FATAL_ERROR "The holdout family ${family} was used for fitting.")
    endif()
endforeach()
